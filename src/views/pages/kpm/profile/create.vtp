<!-- Header -->
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item">
                <a href="/" router-link>Dashboard</a>
            </li>
            @component('breadcrumb', {
                breadcrumbs: pageAttr.breadcrumbs,
                title: pageAttr.title
            })
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                {{pageAttr.title}}
            </h2>
            <p class="text-muted mb-0">
                {{pageAttr.subtitle}}
            </p>
        </div>
    </div>
</div>

<!-- Table Card -->
<form id="crud-form" method="post" class="m-0">
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4>Data Umum</h4>
        </div>
        <div class="card-body p-3 mt-3">
            @for(const field of pageAttr.fields)
            @component('vtp-input', {
                field, data
            })
            @endfor

            @for(const field of otherForm.periods)
            @component('vtp-input', {
                field, data
            })
            @endfor
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4>Data Usaha</h4>
        </div>
        <div class="card-body p-3 mt-3">
            @for(const field of otherForm.business)
            @component('vtp-input', {
                field, data
            })
            @endfor
        </div>
    </div>
    
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4>Asesmen</h4>
        </div>
        <div class="card-body p-3 mt-3">
            @for(const field of otherForm.assessments)
            @component('vtp-input', {
                field, data
            })
            @endfor
        </div>
    </div>
    
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4>Proposal</h4>
        </div>
        <div class="card-body p-3 mt-3">
            @for(const field of otherForm.purposes)
            @component('vtp-input', {
                field, data
            })
            @endfor
        </div>
    </div>
    
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4>RAB</h4>
        </div>
        <div class="card-body p-3 mt-3">
            <!-- Dynamic RAB Table -->
            <div class="table-responsive mb-2">
                <table class="table table-bordered align-middle table-rab mb-0" id="rabTable">
                    <thead>
                        <tr class="text-center">
                            <th style="width: 50px;">No</th>
                            <th style="min-width: 250px;">Uraian</th>
                            <th style="width: 120px;">Jumlah</th>
                            <th style="width: 110px;">Satuan</th>
                            <th style="min-width: 180px;">Harga Satuan</th>
                            <th style="min-width: 200px;">Harga Total</th>
                            <th style="width: 60px;" class="no-print">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="rabTableBody">
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Belum ada item. Klik tombol <b>"Tambah Item"</b> untuk memulai.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Control Button: Add Item -->
            <div class="mb-4 no-print">
                <button class="btn btn-success btn-normal btn-sm" type="button" onclick="rab.addItem()">
                    <i class="bi bi-plus-circle me-1"></i> Tambah Item
                </button>
            </div>

            <!-- Summary Section -->
            <div class="row justify-content-end mt-4">
                <div class="col-md-6 col-lg-5">
                    <div class="card border">
                        <div class="card-body p-3">
                            <!-- BARIS JUMLAH TOTAL -->
                            <div class="d-flex justify-content-between align-items-center p-2 rounded total-highlight">
                                <span class="text-primary fw-bold">JUMLAH TOTAL:</span>
                                <span class="text-primary fw-bold fs-5" id="grandTotalDisplay">Rp 0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terbilang Box -->
            <div class="mt-3 p-3 rounded terbilang-box">
                <span class="fw-bold text-dark">Terbilang: </span>
                <span id="terbilangDisplay" class="text-secondary fw-semibold">Zero Rupiah</span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4>Pendapatan Penerima Manfaat</h4>
        </div>
        <div class="card-body p-3 mt-3">
            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="itemTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">No</th>
                            <th>Deskripsi</th>
                            <th style="width: 250px;">Jumlah</th>
                            <th style="width: 60px;" class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="tableBodyPenghasilan">
                        <tr class="empty-row">
                            <td colspan="4" class="text-center py-4 text-muted">
                                Belum ada penghasilan. Klik tombol <b>"Tambah Penghasilan"</b> untuk memulai.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <button type="button" class="btn btn-normal btn-sm btn-success" id="addRowBtnPenghasilan">
                    <i class="bi bi-plus-lg me-1"></i> Tambah Penghasilan
                </button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h4>Dokumentasi</h4>
        </div>
        <div class="card-body p-3 mt-3">
            @for(const field of otherForm.documents)
            @component('vtp-input', {
                field, data
            })
            @endfor
        </div>
    </div>

    <a href="{{ baseUrl }}" class="btn btn-normal btn-secondary" router-link>Cancel</a>
    <button class="btn btn-normal btn-primary">Submit</button>
</form>