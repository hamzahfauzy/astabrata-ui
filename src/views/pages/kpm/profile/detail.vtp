<!-- Header -->
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item">
                <a href="/" router-link>Dashboard</a>
            </li>
            @component('breadcrumb', {
                breadcrumbs: pageAttr.breadcrumbs,
                title: pageAttr.title
            })
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                {{pageAttr.title}}
            </h2>
            <p class="text-muted mb-0">
                {{pageAttr.subtitle}}
            </p>
        </div>
    </div>
</div>
<div class="container-fluid mx-0 px-0">
    <div class="row">
        <div class="col {{activeStage && userData.permissions.includes(activeStage.permission) && !["Belum Sesuai"].includes(data.period_status) ? 'col-7' : ''}}">
            <div class="card detail-card mb-4">
                <div class="card-header detail-header d-flex justify-content-between align-items-center">
                    <h5 class="detail-title">
                        Data Umum
                    </h5>
                </div>
                
                <div class="card-body detail-body">
                    @for(const field of pageAttr.fields)
                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">{{field.label}}</div>
                        <div class="col-sm-8 detail-value">{{field.value ? field.value(data[field.key], data) : data[field.key]}}</div>
                    </div>
                    @endfor

                    @for(const field of otherView.periods)
                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">{{field.label}}</div>
                        <div class="col-sm-8 detail-value">{{field.value ? field.value(data[field.key], data) : data[field.key]}}</div>
                    </div>
                    @endfor
                </div>

            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="detail-title">
                        Data Usaha
                    </h5>
                </div>
                <div class="card-body p-3 mt-3">
                    @for(const field of otherView.business)
                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">{{field.label}}</div>
                        <div class="col-sm-8 detail-value">{{field.value ? field.value(data[field.key], data) : data[field.key]}}</div>
                    </div>
                    @endfor
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="detail-title">
                        Asesment
                    </h5>
                </div>
                <div class="card-body p-3 mt-3">
                    @for(const field of otherView.assessments)
                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">{{field.label}}</div>
                        <div class="col-sm-8 detail-value">{{field.value ? field.value(data[field.key], data) : data[field.key]}}</div>
                    </div>
                    @endfor
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="detail-title">
                        Proposal
                    </h5>
                </div>
                <div class="card-body p-3 mt-3">
                    @for(const field of otherView.purposes)
                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">{{field.label}}</div>
                        <div class="col-sm-8 detail-value">{{field.value ? field.value(data[field.key], data) : data[field.key]}}</div>
                    </div>
                    @endfor
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h4>RAB</h4>
                </div>
                <div class="card-body p-3 mt-3">
                    <!-- Dynamic RAB Table -->
                    <div class="table-responsive mb-2">
                        <table class="table table-bordered align-middle table-rab mb-0">
                            <thead>
                                <tr class="text-center">
                                    <th style="min-width: 250px;">Uraian</th>
                                    <th style="width: 120px;">Jumlah</th>
                                    <th style="width: 110px;">Satuan</th>
                                    <th style="min-width: 180px;">Harga Satuan</th>
                                    <th style="min-width: 200px;">Harga Total</th>
                                </tr>
                            </thead>
                            <tbody id="rabTableBody">
                                @for(const budget of data.budgets)
                                <tr>
                                    <td>
                                        {{budget.description}}
                                    </td>
                                    <td>
                                        {{budget.qty}}
                                    </td>
                                    <td>
                                        {{budget.unit}}
                                    </td>
                                    <td>
                                        {{budget.price}}
                                    </td>
                                    <td>
                                        {{budget.total_price}}
                                    </td>
                                </tr>
                                @endfor
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h4>Pendapatan Penerima Manfaat</h4>
                </div>
                <div class="card-body p-3 mt-3">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="itemTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Deskripsi</th>
                                    <th style="width: 250px;">Jumlah</th>
                                </tr>
                            </thead>
                            <tbody id="tableBodyPenghasilan">
                                @for(const income of data.incomes)
                                <tr>
                                    <td>
                                        {{income.description}}
                                    </td>
                                    <td>
                                        {{income.amount}}
                                    </td>
                                </tr>
                                @endfor
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h4>Dokumentasi</h4>
                </div>
                <div class="card-body p-3 mt-3">
                    @for(const document of data.documents)
                    <div class="row detail-row">
                        <div class="col-sm-4 detail-label">{{ docs[document.name] }}</div>
                        <div class="col-sm-8 detail-value">
                            <a href="{{ storageUrl + document.file_url }}" target="_blank">Lihat File</a>
                        </div>
                    </div>
                    @endfor
                </div>
            </div>
        </div>
        @if(activeStage && userData.permissions.includes(activeStage.permission) && !["Belum Sesuai"].includes(data.period_status))
        <div class="col col-5">
            <form id="stage-form" method="post" class="m-0">
                @for(const section of activeStage.form.sections)
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h4>{{section.label}}</h4>
                    </div>
                    <div class="card-body p-3 mt-3">
                        @for(const field of section.fields)
                        @component('vtp-input', {
                            field, data: data.lastStage.data ?? {}
                        })
                        @endfor
                    </div>
                </div>
                @endfor
                <button class="btn btn-normal btn-primary w-100">Submit</button>
            </form>
        </div>
        @endif
    </div>
</div>